<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The tag is the version and the only source of one: a release passes
       `-p:Version=` from the tag it was started by. A build nobody tagged says
       so rather than claiming a number that was never released. The CLI reads
       the same string out of its own linker flag, so the two halves of one
       release cannot disagree about which release they are. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <!-- Nothing here is published as a package. The API is the only interface to
       this product (Specification §9), its web client is generated from the
       contract and its CLI is a Go binary, so the .NET side ships as one
       container image and nothing else. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
