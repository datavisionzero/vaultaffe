<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Only what something already uses. A version pinned before there is a
       reference to it is a decision with no reason attached — the schema, the
       encryption and the contract each bring their own with the code that needs
       them. -->

  <ItemGroup Label="Persistence">
    <!-- The one place that declares schema (docs/codebase.md): EF Core owns the
         tables and the migrations that apply themselves on startup. The
         design-time package is what `dotnet ef migrations add` needs, and it
         stays out of the runtime through PrivateAssets on the reference. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <!-- The Npgsql provider asks for an older EF Core patch than the design-time
         package does. Pinned to one version so the two do not meet as a runtime
         binding conflict in the test project, where both arrive. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Identity">
    <!-- Argon2id, which the base class libraries do not carry. The encoded value
         is self-describing — algorithm and parameters travel with the hash — so
         raising the cost later is a re-hash on the next sign-in rather than a
         migration. -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Contract">
    <!-- The OpenAPI document is the contract, and the web client is generated
         from it (ADR 0006). ASP.NET's own generator produces it from the
         endpoint definitions, which is what keeps it a description of what is
         served rather than a wish. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- Starts the whole application in the test process, so that what a test
         asks is asked of a running instance over HTTP. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />

    <!-- Nothing here calls SSH.NET. It arrives under Testcontainers, whose
         newest release still asks for the version GHSA-q939-rpr3-3284 was filed
         against — and `TreatWarningsAsErrors` turns that audit warning into a
         failed restore.

         The exposure was never real: the advisory is about recursive `ScpClient`
         downloads from a server that picks the filenames, in a test dependency
         that never reaches the image. What is real is that a red trunk stops
         everything else (ADR 0001), which is why this is pinned rather than
         suppressed. Drop both lines once Testcontainers asks for the patched
         version itself. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
