<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Only what something already uses. A version pinned before there is a
       reference to it is a decision with no reason attached — the schema, the
       encryption and the contract each bring their own with the code that needs
       them. -->

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />

    <!-- Nothing here calls SSH.NET. It arrives under Testcontainers, whose
         newest release still asks for the version GHSA-q939-rpr3-3284 was filed
         against — and `TreatWarningsAsErrors` turns that audit warning into a
         failed restore.

         The exposure was never real: the advisory is about recursive `ScpClient`
         downloads from a server that picks the filenames, in a test dependency
         that never reaches the image. What is real is that a red trunk stops
         everything else (ADR 0001), which is why this is pinned rather than
         suppressed. Drop both lines once Testcontainers asks for the patched
         version itself. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
