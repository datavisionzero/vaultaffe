<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../Vaultaffe.Application/Vaultaffe.Application.csproj" />
  </ItemGroup>

  <!-- Postgres, the envelope encryption and the schema live here, and each
       brings its packages with the code that uses them. -->
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only: this project is its own startup project for
         `dotnet ef`, through the factory in Persistence. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
