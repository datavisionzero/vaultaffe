# The build context is the repository root; this keeps out of it what the image
# never needs. `.git/` is excluded on purpose — the commit reaches the build as
# the REVISION argument, not by reading the repository.
.git/
**/bin/
**/obj/
scratchpad/
tests/
docs/
!docs/api/openapi.json
**/node_modules/
src/Vaultaffe.Api/wwwroot/
src/web/dist/
src/cli/
.github/

# The instance configuration, which is the one file in this product expected to
# hold the master key. Nothing in the image is built from it, and a build
# context is a thing that gets copied around: it stays out.
deploy/
*.md
